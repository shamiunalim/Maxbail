{
  "name": "maxiel-xy",
  "version": "0.1.0",
  "description": "Maxiel-Xy fork scaffold for a maintained Baileys-based library",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
